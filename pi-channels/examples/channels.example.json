{
  "defaultChannel": "telegram",
  "proactivePush": true,
  "channels": {
    "telegram": {
      "profiles": {
        "default": {
          "enabled": true,
          "botToken": "REPLACE_ME",
          "allowedUserId": 0,
          "render": {
            "finalFormat": "compat",
            "sanitizeMarkdown": true,
            "neutralizeMath": true,
            "draftPreviews": false
          }
        }
      }
    },
    "qqbot": {
      "profiles": {
        "default": {
          "enabled": true,
          "appId": "REPLACE_APP_ID",
          "clientSecret": "REPLACE_CLIENT_SECRET",
          "allowedOpenId": "",
          "enableGroup": false,
          "sandbox": false,
          "render": {
            "finalFormat": "plain",
            "sanitizeMarkdown": true,
            "neutralizeMath": true,
            "draftPreviews": false
          },
          "progress": {
            "mode": "progress",
            "startDelayMs": 2500,
            "maxLines": 3,
            "maxLineChars": 80,
            "minEditIntervalMs": 2000
          }
        }
      }
    },
    "webhook": {
      "profiles": {
        "default": {
          "enabled": false,
          "note": "phase 4 — proves multi-channel core"
        }
      }
    }
  }
