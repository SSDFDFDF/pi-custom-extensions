{
  "name": "pi-loop",
  "version": "0.2.0",
  "description": "Pi extension: /loop <interval> | in <delay> | at <time> [every <interval>] [xN] [now] <instruction> — periodic or scheduled self-triggered reports.",
  "type": "module",
  "private": true,
  "keywords": ["pi-package", "pi-extension", "loop", "scheduler", "cron", "reminder"],
  "license": "MIT",
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.mjs",
    "check": "node --experimental-strip-types --check src/index.ts && node --experimental-strip-types --check src/parse.ts"
  },
  "pi": {
    "extensions": ["./src/index.ts"]
  }
}